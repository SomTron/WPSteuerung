# Ignoriere Konfigurationsdateien mit sensiblen Daten
richtige_config.ini
config.ini

# Ignoriere InfodatepÃ­
Infos

# Ignoriere Runtime-Dateien (Logs)
*.log
# Tagesbasiert rotierte Log-Generationen: heizungssteuerung.log.2026-10-20,
# error.log.2026-10-20, ... Das Muster "*.log" trifft sie NICHT, weil sie
# nicht auf ".log" enden. Ohne diesen Eintrag tauchen sie als untracked auf.
*.log.[0-9]*
*.log.[0-9]*.[0-9]*

# Haltbarer Zustands-Schnappschuss (Laufzeit, nie committen)
last_state.txt
# Startup-Diagnose: Status des letzten Laufs (unsauber beendet? OOM-Kill?)
letzter_lauf.json
absturz_historie.json

# Modi-Persistenz (Bademodus/Urlaubsmodus, Laufzeit-Zustand, nie committen)
Steuerung/modi_zustand.json
Steuerung/legionellen_plan.json
legionellen_plan.json

# Startup-Diagnose: Status des letzten Laufs (unsauber beendet? OOM-Kill?)
letzter_lauf.json
absturz_historie.json

# Diagnose-/Analyse-Artefakte (lokal ausgewertet, nie committen - teils >10 MB)
logs/wp_diag_*/
# Exportierte Betriebsdaten (CSV/Log aus dem realen Betrieb).
# Sie gehoeren nicht ins Repository - sehr gross und personenbezogen.
# Muster deckt alle Versionsordner (logs/24.9/, logs/1.10.26/, ...);
# der Punkt im Muster verhindert Treffer auf lose Dateien wie logs/941fgu.
logs/[0-9]*.*/
logs/entscheidungs_log_*.txt
logs/heizungssteuerung*.log
logs/*_upload*.txt
logs/sim_*.json

logs/analyse_*/

# Laufzeit-Datei des Services (wird fortlaufend neu geschrieben - nervt sonst
# bei jedem Deploy mit "lokale Aenderungen verwerfen?")
Steuerung/sonnen_prognose.csv

# Laufzeit-Historien im Hauptordner ignorieren, aber nicht im Analyse-Ordner
Steuerung/csv\ log/heizungsdaten.csv
Steuerung/csv\ log/heizungsdaten_*.csv
Steuerung/csv\ log/zyklen.csv
Steuerung/csv\ log/zyklen_*.csv
!Analyse/
!Analyse/*.csv
Analyse/*.md
Analyse/*.html
# Ausnahme: die HANDGESCHRIEBENE Uebersicht der Analyse-Werkzeuge (die
# uebrigen Markdown-Dateien dort sind generierte Berichte).
!Analyse/README.md

# Ignoriere Test-Outputs
*_out.txt
sim_*.txt
test_results.txt
raw_sim.txt

# Ignoriere PyCharm-Projektdateien
.idea/

# Ignoriere virtuelle Environments
.venv/

# Python Cache
__pycache__/
*.pyc

# Generierte Prognose-Daten
Steuerung/sonnen_prognose.csv
# Cursor AI / IDE
.antigravity/
*.pyc
__pycache__/

# Lokale CI-Testumgebung (versehentlich erzeugt)
.ci_venv/

# Entscheidungs-Log (Laufzeit, rotierend, nie committen)
Steuerung/entscheidungs_log.jsonl
Steuerung/entscheidungs_log.jsonl.old

# Lokale Backups fremder Aenderungen
_fremde_aenderungen_backup/

# Wegwerf-Debugskripte (Einmal-Analyse im Projektordner). Sie brechen den
# CI-Lint (ruff prueft "Steuerung" komplett) und gehoeren nicht ins Repo.
Steuerung/_demo*.py

# Lerndaten der LearningEngine (Laufzeit, nie committen)
Steuerung/learning_data.json
learning_data.json

# ---------------------------------------------------------------------------
# BUGFIX (22.10.2026): Laufzeit-Artefakte und tote Ordner.
#
# 1) "Steuerung/csv log/" ist ein LAUFZEIT-Verzeichnis (cycle_logging.py
#    schreibt zyklen.csv hinein, cleanup_pi.sh legt es an). Bisher
#    ignorierten nur einzelne Dateinamen - alles andere landete im Repo.
#    Beispiel: heizungsdaten2.csv (8 MB!) lag versioniert im Baum.
#    Der Ordnername MIT LEERZEICHEN ist zusaetzlich eine Linux-Falle:
#    ein Shell-Skript mit unquotedem Pfad bricht daran.
#    Deshalb: der komplette Ordner ist ausgenommen.
Steuerung/csv log/
Steuerung/csv\ log/
Steuerung/csv_log/

# 2) "Steuerung/simulated_w1/" - simulierte Geraete aus dem
#    Shelly-Simulationstest. Reine Test-Artefakte, nie committen.
Steuerung/simulated_w1/

# 3) "Steuerung/backup/" - .bak-Dateien aus dem Betrieb. Nie committen.
Steuerung/backup/

# 4) Python-Cache in Unterordnern (lag bereits in archive/).
Steuerung/archive/__pycache__/
Steuerung/simulation/__pycache__/

# ---------------------------------------------------------------------------
# BUGFIX (24.10.2026): Laufzeit-Artefakte aus dem Repo-ROOT.
#
# Das unfertige Skript test_header_fix.py prueft utils.check_and_fix_csv_header
# im Root und legt dabei "backup/" und "csv log/" an - beides landete im
# Commit. Im Betrieb laeuft der Dienst in Steuerung/ (dort sind die Ordner
# bereits ignoriert); ein Test im Root darf dieselbe Falle nicht erneut
# ausloesen.
backup/
csv log/
csv\ log/

# Sicherheitsbackups von utils.backup_csv() (z.B. heizungsdaten.csv_20260214_114549.bak)
# und manuelle .bak-Kopien von Deploy-Skripten.
*.csv_*.bak
Updater/*.bak
