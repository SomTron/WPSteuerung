[Heizungssteuerung]
MIN_LAUFZEIT = 60
MIN_PAUSE = 30
NACHTABSENKUNG_START = 19:30
NACHTABSENKUNG_END = 8:00
VERDAMPFERTEMPERATUR = 6
SICHERHEITS_TEMP = 58
NACHTABSENKUNG = 15
EINSCHALTPUNKT_ERHOEHT = 40
AUSSCHALTPUNKT_ERHOEHT = 48
TEMP_OFFSET = 3
EINSCHALTPUNKT = 42
AUSSCHALTPUNKT = 48
UEBERGANGSMODUS_MORGENS_ENDE = 10:00
UEBERGANGSMODUS_ABENDS_START = 17:00

[Healthcheck]
HEALTHCHECK_URL = https://hc-ping.com/YOUR_UUID_HERE
HEALTHCHECK_INTERVAL_MINUTES = 15

[SolaxCloud]
TOKEN_ID = YOUR_TOKEN_ID_HERE
SN = YOUR_SERIAL_NUMBER_HERE

[Telegram]
BOT_TOKEN = YOUR_BOT_TOKEN_HERE
CHAT_ID = YOUR_CHAT_ID_HERE

[Urlaubsmodus]
URLAUBSABSENKUNG = 15

[Solarueberschuss]
BATPOWER_THRESHOLD = 600.0
SOC_THRESHOLD = 95.0
FEEDINPOWER_THRESHOLD = 600.0

[Logging]
ENABLE_FULL_LOG = True

[Wetterprognose]
LATITUDE = 46.7142
LONGITUDE = 13.6361
TILT = 30

[Netzwerk]
# Nameserver fuer die ausgehenden HTTP-Verbindungen (Healthcheck, Telegram,
# Solax). Komma-getrennt.
#
# Leer lassen = System-Resolver aus /etc/resolv.conf (Default). Der folgt
# automatisch jeder Netz-/Router-Aenderung, haengt aber an tailscaled: faellt es
# aus, sind Healthcheck, Telegram und Solax gleichzeitig blind, waehrend der
# Fernzugriff (Funnel) weiterlaeuft. Wer Tailscale aus dem Pfad nehmen will,
# traegt hier Namen ein - die ortsunabhaengige Tailnet-Adresse zuerst, den
# Router danach:
#   DNS_SERVER = 100.100.100.100, 192.168.178.1
#
# Die Reihenfolge ist wichtig: c-ares wartet den Timeout des ersten Eintrags ab,
# bevor es den naechsten nimmt. Ein veralteter ERSTER Eintrag kostet daher bei
# jedem Lookup Zeit; an zweiter Stelle kostet er nichts.
#
# Alle Eintraege werden beim Start kurz geprueft (UDP/53, 1 s). Was nicht
# antwortet, wird uebersprungen und als WARNING geloggt - ein Tippfehler oder
# ein Routerwechsel erzeugt damit keinen Ausfall mehr.
#
# Bitte KEINE oeffentlichen Resolver fest eintragen, ohne sie vorher zu testen
# (python3 Updater/dns-diag.py 1.1.1.1 8.8.8.8). Sind sie im Netz gesperrt,
# scheitert jeder Lookup mit "aiodns.error.DNSError: (12, 'Timeout while
# contacting DNS servers')". Diese Werte sind umgebungsspezifisch und gehoeren
# in config.ini, nicht in den Code.
DNS_SERVER =
