[Heizungssteuerung]
MIN_LAUFZEIT = 60
MIN_PAUSE = 30
NACHTABSENKUNG_START = 19:30
NACHTABSENKUNG_END = 8:00
VERDAMPFERTEMPERATUR = 6
SICHERHEITS_TEMP = 58
NACHTABSENKUNG = 15
EINSCHALTPUNKT_ERHOEHT = 40
AUSSCHALTPUNKT_ERHOEHT = 48
TEMP_OFFSET = 3
EINSCHALTPUNKT = 42
AUSSCHALTPUNKT = 48
UEBERGANGSMODUS_MORGENS_ENDE = 10:00
UEBERGANGSMODUS_ABENDS_START = 17:00

[Healthcheck]
HEALTHCHECK_URL = https://hc-ping.com/YOUR_UUID_HERE
HEALTHCHECK_INTERVAL_MINUTES = 15

[SolaxCloud]
TOKEN_ID = YOUR_TOKEN_ID_HERE
SN = YOUR_SERIAL_NUMBER_HERE

[Telegram]
BOT_TOKEN = YOUR_BOT_TOKEN_HERE
CHAT_ID = YOUR_CHAT_ID_HERE

[Urlaubsmodus]
URLAUBSABSENKUNG = 15

[Solarueberschuss]
BATPOWER_THRESHOLD = 600.0
SOC_THRESHOLD = 95.0
FEEDINPOWER_THRESHOLD = 600.0

[Logging]
ENABLE_FULL_LOG = True

[Wetterprognose]
LATITUDE = 46.7142
LONGITUDE = 13.6361
TILT = 30

[Netzwerk]
# Nameserver fuer die ausgehenden HTTP-Verbindungen (Healthcheck, Telegram,
# Solax). Komma-getrennt, z.B.:
#   DNS_SERVER = 192.168.178.1, 1.1.1.1
#
# Leer lassen = System-Resolver aus /etc/resolv.conf (empfohlener Default).
# Auf einem Pi, dessen resolv.conf von Tailscale verwaltet wird, ist das
# jedoch ein Single Point of Failure: faellt tailscaled aus, sind Healthcheck,
# Telegram und die Solax-API gleichzeitig blind, waehrend der Fernzugriff
# weiterlaeuft. Dann hier einen lokal erreichbaren Nameserver eintragen -
# bevorzugt die Fritz!Box.
#
# Bitte KEINE oeffentlichen Resolver fest eintragen, ohne sie vorher zu
# testen (dig @8.8.8.8 hc-ping.com). Sind sie im Netz gesperrt, scheitert
# jeder Lookup mit "aiodns.error.DNSError: (12, 'Timeout while contacting
# DNS servers')". Die Werte hier sind umgebungsspezifisch und gehoeren
# deshalb in config.ini, nicht in den Code.
DNS_SERVER =
